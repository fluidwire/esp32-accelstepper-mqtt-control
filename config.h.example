// config.h.example - copy this file to config.h and fill in your own values.
// config.h is .gitignore'd so your secrets never leave your machine.

#pragma once

// --- WiFi -------------------------------------------------------------------
#define WIFI_SSID      "your-wifi-ssid"
#define WIFI_PASSWORD  "your-wifi-password"

// --- MQTT broker ------------------------------------------------------------
// Public test broker (no auth): "test.mosquitto.org", port 1883
// HiveMQ public: "broker.hivemq.com", port 1883
// Self-hosted: your broker host/IP
#define MQTT_HOST        "broker.hivemq.com"
#define MQTT_PORT        1883
#define MQTT_CLIENT_ID   "fluidwire-esp32-stepper"
#define MQTT_USER        ""        // leave blank for anonymous brokers
#define MQTT_PASSWORD    ""

// --- Topics -----------------------------------------------------------------
// Commands (plain text) on the command topic:
//   <integer>  move to that absolute position, in steps (e.g. 1600)
//   home       run the homing routine toward the limit switch, then zero
//   stop       decelerate to a halt as fast as the ramp allows
// The device reports its position (steps) and status to the state topics.
#define MQTT_CMD_TOPIC     "fluidwire/demo/stepper/cmd"
#define MQTT_STATE_TOPIC   "fluidwire/demo/stepper/position"
#define MQTT_STATUS_TOPIC  "fluidwire/demo/stepper/status"
